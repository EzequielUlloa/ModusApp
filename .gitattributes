# Normaliza los finales de línea para evitar advertencias de LF/CRLF
* text=auto eol=lf

# Código fuente
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.pro text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows batch scripts necesitan CRLF
*.bat text eol=crlf

# Binarios: no tocar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.keystore binary
*.ttf binary
*.otf binary
